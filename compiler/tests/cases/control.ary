لكل ع في نطاق(٥):
    إذا ع يساوي ٣:
        اكسر
وإلا:
    اطبع("لن يُطبع")
لكل ع في نطاق(٢):
    يمر
وإلا:
    اطبع("انتهت الحلقة بلا كسر")

ع = ٠
بينما ع < ١٠:
    ع += ١
    إذا ع % ٢:
        استمرار
    إذا ع > ٦:
        اكسر
    اطبع(ع، end=" ")
اطبع()

دالة ف():
    حاول:
        أرجع "من حاول"
    أخيرا:
        اطبع("أخيرا تعمل دائما")
اطبع(ف())

دالة ق(س):
    حاول:
        إذا س:
            رفع ValueError("سيء")
        اطبع("بلا خطأ")
    عدا (TypeError، ValueError) كـ خ:
        اطبع("خطأ:", خ)
    وإلا:
        اطبع("وإلا بعد حاول")
    أخيرا:
        اطبع("أخيرا")
ق(خطأ)
ق(صحيح)

حاول:
    حاول:
        ١ / ٠
    عدا ZeroDivisionError:
        اطبع("داخلي")
        رفع
عدا ArithmeticError كـ خ:
    اطبع("خارجي:", نوع(خ).__name__)

س = ٥
اطبع(١ < س < ١٠، ١ < س > ١٠، س هو لاشيء، لاشيء هو لاشيء، س هو غير لاشيء)
اطبع("أ" إذا س > ٣ وإلا "ب")
اطبع(غير صحيح، صحيح و ٠، ٠ أو "افتراضي"، [] أو {})
أ، (ب، ج) = ١، (٢، ٣)
اطبع(أ، ب، ج)
أ = ب = []
أ += [١]
اطبع(ب)
