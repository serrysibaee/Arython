صنف حيوان:
    النوع = "حيوان"
    دالة __init__(self، الاسم):
        self.الاسم = الاسم
    دالة تكلم(self):
        أرجع "..."
    دالة __str__(self):
        أرجع f"{self.النوع} اسمه {self.الاسم} يقول {self.تكلم()}"

صنف قطة(حيوان):
    النوع = "قطة"
    دالة __init__(self، الاسم، العمر):
        super().__init__(الاسم)
        self.العمر = العمر
    دالة تكلم(self):
        أرجع "مياو"

صنف نقطة:
    دالة __init__(self، س، ص):
        self.س = س
        self.ص = ص
    دالة __add__(self، أخرى):
        أرجع نقطة(self.س + أخرى.س، self.ص + أخرى.ص)
    دالة __eq__(self، أخرى):
        أرجع self.س يساوي أخرى.س و self.ص يساوي أخرى.ص
    دالة __repr__(self):
        أرجع f"نقطة({self.س}، {self.ص})"
    دالة __lt__(self، أخرى):
        أرجع (self.س، self.ص) < (أخرى.س، أخرى.ص)

ق = قطة("بسبس"، ٣)
اطبع(ق)
اطبع(ق.العمر، ق.النوع، حيوان.النوع)
اطبع(isinstance(ق، حيوان)، isinstance(ق، قطة)، isinstance(حيوان("س")، قطة))
اطبع(نقطة(١، ٢) + نقطة(٣، ٤))
اطبع(نقطة(١، ٢) يساوي نقطة(١، ٢)، نقطة(١، ٢) لا_يساوي نقطة(٢، ٢))
اطبع([نقطة(١، ١)، نقطة(٢، ٢)])
اطبع(نقطة(١، ٥) < نقطة(٢، ٠))
اطبع(نوع(ق).__name__، نوع(٥)، نوع("س")، نوع([]))

صنف خطئي(Exception):
    يمر

حاول:
    رفع خطئي("شيء ما خطأ")
عدا خطئي كـ خ:
    اطبع("التقطت:", خ، نوع(خ).__name__)

صنف رصيد_غير_كاف(ValueError):
    دالة __init__(self، المطلوب):
        super().__init__(f"المطلوب {المطلوب}")
        self.المطلوب = المطلوب
حاول:
    رفع رصيد_غير_كاف(٥٠)
عدا ValueError كـ خ:
    اطبع(خ، خ.المطلوب، خ.args)
