# دوال داخلية، nonlocal، global، lambda
دالة عداد():
    ع = ٠
    دالة زد():
        غير_محلي ع
        ع += ١
        أرجع ع
    أرجع زد

ز = عداد()
ز()
ز()
اطبع("العداد:", ز())

المجموع_الكلي = ٠
دالة أضف_للكلي(ن):
    عالمي المجموع_الكلي
    المجموع_الكلي += ن
أضف_للكلي(٥)
أضف_للكلي(٧)
اطبع(المجموع_الكلي)

دوال = [lambda س، ك=ك: س * ك لكل ك في نطاق(٣)]
اطبع([د(١٠) لكل د في دوال])

دالة مضاعف(ن):
    أرجع lambda س: س * ن
ثلاثي = مضاعف(٣)
اطبع(ثلاثي(٧))

دالة خارجية():
    س = "خارجي"
    دالة وسطى():
        دالة داخلية():
            أرجع س
        أرجع داخلية()
    أرجع وسطى()
اطبع(خارجية())

دالة مرن(أ، ب=٢، *باقي، **خيارات):
    اطبع(أ، ب، باقي، خيارات)
مرن(١)
مرن(١، ٣، ٤، ٥، لون="أحمر")
مرن(*[٩، ٨]، **{"س": ١})
مرتبة = مرتب(["تفاح"، "موز"، "عنب"، "كرز"]، key=lambda ك: (طول(ك)، ك)، reverse=صحيح)
اطبع(مرتبة)
